rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function pairId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function otherOf(id) { return id.split('_')[0] == me() ? id.split('_')[1] : id.split('_')[0]; }
    function isFriend(other) {
      let path = /databases/$(database)/documents/friendships/$(pairId(me(), other));
      return exists(path) && get(path).data.status == 'accepted';
    }
    function sharedOf(uid) {
      return get(/databases/$(database)/documents/shared/$(uid)).data;
    }

    // Private data & cloud backups: owner only
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && me() == uid;
    }
    // Public profile (name, avatar, invite code)
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && me() == uid;
    }
    match /inviteCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me();
      allow update, delete: if signedIn() && resource.data.uid == me();
    }
    // Friend requests / friendships: id = uidA_uidB (sorted)
    match /friendships/{id} {
      allow get: if signedIn() && me() in id.split('_');
      allow list: if signedIn() && me() in resource.data.users;
      allow create: if signedIn()
        && request.resource.data.from == me()
        && request.resource.data.status == 'pending'
        && request.resource.data.users.size() == 2
        && me() in request.resource.data.users
        && id == pairId(request.resource.data.users[0], request.resource.data.users[1]);
      allow update: if signedIn() && me() in resource.data.users
        && resource.data.from != me()
        && request.resource.data.status == 'accepted'
        && request.resource.data.users == resource.data.users
        && request.resource.data.from == resource.data.from;
      allow delete: if signedIn() && me() in resource.data.users;
    }
    // What each user chooses to share with friends (timetable + permissions)
    match /shared/{uid} {
      allow read: if signedIn() && (me() == uid || isFriend(uid));
      allow write: if signedIn() && me() == uid;
    }
    // Chats between two friends
    match /chats/{id} {
      allow get, write: if signedIn() && me() in id.split('_') && isFriend(otherOf(id));
      allow list: if signedIn() && me() in resource.data.users;
      match /messages/{mid} {
        allow read: if signedIn() && me() in id.split('_') && isFriend(otherOf(id));
        allow create: if signedIn() && me() in id.split('_') && isFriend(otherOf(id))
          && request.resource.data.from == me()
          && (request.resource.data.type != 'poke' || sharedOf(otherOf(id)).allowReminders != false)
          && (request.resource.data.type == 'poke' || sharedOf(otherOf(id)).allowChat != false);
        allow update: if signedIn() && resource.data.from == me() && resource.data.type == 'text'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'editedAt']);
        allow delete: if signedIn() && resource.data.from == me();
      }
    }
  }
}
